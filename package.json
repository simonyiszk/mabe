{
	"name": "mabe-website",
	"version": "1.2.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"build:analyze": "cross-env ANALYZE=true npm run build",
		"clean": "git clean --force -dx --exclude .env.local --exclude .env.*.local --exclude node_modules/",
		"dev": "next dev",
		"fix": "run-s fix:*",
		"fix:eslint": "npm run lint:eslint -- --fix",
		"fix:prettier": "npm run lint:prettier -- --write",
		"lint": "run-p lint:*",
		"lint:eslint": "eslint --ext .js,.ts,.tsx --ignore-path ./.gitignore .",
		"lint:prettier": "prettier --check --ignore-path ./.gitignore .",
		"lint:typescript": "tsc",
		"start": "next start",
		"cms-typegen": "contentful-typescript-codegen --output src/@types/generated/contentful.d.ts",
		"changeset": "changeset",
		"ctg": "cf-content-types-generator"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown",
		"*.{js,ts,tsx}": "eslint --fix"
	},
	"dependencies": {
		"@contentful/rich-text-react-renderer": "^15.22.11",
		"@contentful/rich-text-types": "^16.8.5",
		"clsx": "^2.1.1",
		"contentful": "^11.1.4",
		"contentful-management": "^11.35.1",
		"next": "^14.2.15",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.3.0",
		"sharp": "^0.33.5"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tsconfig/next": "^2.0.3",
		"@types/node": "^22.7.6",
		"@types/react": "^18.3.11",
		"@typescript-eslint/eslint-plugin": "^8.10.0",
		"@typescript-eslint/parser": "^8.10.0",
		"autoprefixer": "^10.4.20",
		"cf-content-types-generator": "^2.15.5",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.5",
		"eslint": "^9.12.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-airbnb-typescript": "^18.0.0",
		"eslint-config-next": "^14.2.15",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-etc": "^2.0.3",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.0",
		"eslint-plugin-next": "^0.0.0",
		"eslint-plugin-react": "^7.37.1",
		"eslint-plugin-react-etc": "^2.0.1",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-tailwindcss": "^3.17.5",
		"lint-staged": "^15.2.10",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.47",
		"prettier": "^3.3.3",
		"tailwindcss": "^3.4.14",
		"typescript": "^5.6.3"
	}
}
